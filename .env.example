# Ne placez jamais ces valeurs dans le code ou dans Git.
# Stripe Checkout est le module de paiement actif.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Facultatif : laissez vide si Stripe ne vous a pas fourni de pmc_... valide.
STRIPE_PAYMENT_METHOD_CONFIGURATION=
# URL publique HTTPS, sans slash final.
PUBLIC_BASE_URL=https://pay.westparadise.fr

# Ancienne intégration Monetico conservée en secours, inactive dans le parcours client.
CIC_TPE=
CIC_SOCIETE=
CIC_KEY=
CIC_MODE=test
