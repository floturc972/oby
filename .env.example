# Ne placez jamais ces valeurs dans le code ou dans Git.
# Monetico CIC : saisir les identifiants de TEST d'abord. Ne jamais versionner ce fichier.
CIC_TPE=
CIC_SOCIETE=
CIC_KEY=
CIC_MODE=test
# URL publique HTTPS, sans slash final.
PUBLIC_BASE_URL=https://pay.westparadise.fr
# Stripe est facultatif ; laissez vide tant que Monetico est le module actif.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHOD_CONFIGURATION=
